enum Gender {
  M
  F
  N
}

// 1. STATIC CATALOG: Vox and Vivi
model Sprite {
  id        String   @id @default(cuid())
  slug      String   @unique // "vox" | "vivi"
  name      String // "Vox" | "Vivi"
  avatarUrl String // "/sprite-m.png" | "/sprite-f.png"
  moodUrls  String[]
  persona   String?

  profiles SpriteProfile[]
}

// 2. USER'S SELECTION: Links User -> Sprite + their chosen Voice IDs
model SpriteProfile {
  id       String @id @default(cuid())
  userId   String @unique
  spriteId String

  nativeLanguage String // e.g. "en-US"
  targetLanguage String // e.g. "fr-FR"
  nativeVoiceId  String // e.g. "en-US-boy-01"
  targetVoiceId  String // e.g. "fr-FR-boy-01"

  // 🟢 NEW: Sprite Stamina / Energy Charges (Earned via Boss 3-streak or Sprite Exercises)
  energy    Int @default(1)
  maxEnergy Int @default(3)

  context Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sprite Sprite @relation(fields: [spriteId], references: [id])

  // 🟢 NEW: Saved Chat Sessions
  sessions        SpriteSession[]
  spriteExercises SpriteExercise[]
}

model SpriteSession {
  id              String @id @default(cuid())
  spriteProfileId String

  title       String  @default("New Session")
  lessonTitle String?

  turns Json @default("[]")

  // 🟢 NEW: Tracks which curriculum stage this board used (e.g. "spoon-16" or "boss-5")
  stageKey String?

  // 🟢 NEW: Stores the latest/completed Step-Deck Board & user attempt history for this session!
  board Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  spriteProfile SpriteProfile @relation(fields: [spriteProfileId], references: [id], onDelete: Cascade)

  @@index([spriteProfileId, updatedAt(sort: Desc)])
}

// 3. GLOBAL DETERMINISTIC CACHE (Option 1)
model SpriteNode {
  id             String @id @default(cuid())
  nodeId         String @unique // "vox:en-US-boy-01:fr-FR-boy-01:1"
  spriteSlug     String // "vox" | "vivi"
  nativeLanguage String // "en-US"
  targetLanguage String // "fr-FR"
  nativeVoiceId  String // "en-US-boy-01"
  targetVoiceId  String // "fr-FR-boy-01"
  orderIndex     Int // 1=Spoon1, 2=Spoon2, 3=Spoon3, 4=Boss1

  header         String // "Spoon 1 Ready 🥄"
  nativeBody     String  @db.Text
  targetBody     String  @db.Text
  nativeAudioUrl String? // S3 key for native MP3
  targetAudioUrl String? // S3 key for target MP3
  action         String? // "Start Spoon 1"

  createdAt DateTime @default(now())

  @@index([spriteSlug, orderIndex])
}

// 🟢 NEW: On-Demand Targeted Repair Drill built from Chalkboard Mistakes + Weak Words
model SpriteExercise {
  id              String  @id @default(cuid())
  spriteProfileId String
  userId          String
  courseId        String?

  title  String @default("Sprite Repair Drill")
  status String @default("BUILDING") // "BUILDING" | "READY" | "COMPLETED" | "FAILED"

  // The struggled steps & weak words that triggered this exercise
  sourceMistakes Json @default("[]")

  // The generated 3-to-5 repair drill items (populated by webhook)
  content Json?

  // Rewards +1 Energy Charge upon completion (guarded so it can only be claimed once)
  energyReward  Int       @default(1)
  rewardClaimed Boolean   @default(false)
  completedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  spriteProfile SpriteProfile @relation(fields: [spriteProfileId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([spriteProfileId, createdAt(sort: Desc)])
}

model SpoonBook {
  id                 String   @id @default(cuid())
  slug               String   @unique // e.g. "the-midnight-ticket"
  characterName      String
  characterAvatarUrl String   // Cloudinary reference avatar URL
  levelBand          String   @default("beginner")
  genre              String   @default("story")

  coverImageS3Key    String
  introVideoS3Key    String?

  // S3 keys for the 5 shared page illustrations: ["books/.../page_1.png", ...]
  pageImageS3Keys    String[]

  // Keyed by locale ("fr-FR", "es-ES", "en-US") -> { title, synopsis, pages: [...] }
  translations       Json

  isPublished        Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  progress           UserBookProgress[]
}

model UserBookProgress {
  id                   String    @id @default(cuid())
  userId               String
  spoonBookId          String
  targetLanguage       String    // "fr-FR" | "es-ES" | "en-US"

  currentPage          Int       @default(1) // 1..5
  completedCheckpoints Json      @default("[]") // e.g. [1, 2, 3]
  quizScore            Int?      // 0..100
  completedAt          DateTime?

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  spoonBook            SpoonBook @relation(fields: [spoonBookId], references: [id], onDelete: Cascade)

  @@unique([userId, spoonBookId, targetLanguage])
}

model User {
  id    String @id @default(cuid())
  email String @unique
  name  String

  // Kept clean via 1-to-1 SpriteProfile relation:
  spriteProfile SpriteProfile?

  emailVerified   Boolean @default(false)
  image           String?
  username        String? @unique
  displayUsername String?
  firstName       String?
  lastName        String?
  gender          Gender? @default(N)

  avatarUrl  String?
  phone      String?
  banned     Boolean?  @default(false)
  banReason  String?
  banExpires DateTime?

  sessions Session[]
  accounts Account[]

  role      UserRole @default(CUSTOMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nativeLanguage Languages? @default(ENGLISH)
  targetLanguage Languages? @default(FRENCH)

  Journal               Journal[]
  StoryQuestions        StoryQuestions[]
  PronunciationSession  PronunciationSession[]
  PronunciationProgress PronunciationProgress[]
  PracticeSessions      PracticeSession[]
  BookReport            BookReport[]
  Book                  Book[]
  Conversation          Conversation[]
  LearningProgress      LearningProgress[]
  ConversationRecord    ConversationRecord[]
  AccountSettings       AccountSettings?
  BillingInformation    BillingInformation?
  UserProgress          UserProgress[]
  Like                  Like[]
  Course                Course[]
  Enrollment            Enrollment[]
  Progress              Progress[]
  Teacher               Teacher?
  QuizResult            QuizResult[]
  Resource              Resource[]
  AIGeneratedContent    AIGeneratedContent[]
  notifications         Notification[]
  GameScore             GameScore[]
  UserSchedule          UserSchedule[]
  ConversationReview    ConversationReview[]
  ReadingLog            ReadingLog[]
  dailyJournals         DailyJournal[]
  FreestyleSession      FreestyleSession[]
  FoundationProgress    FoundationProgress?

  FoundationLesson       FoundationLesson[]
  FoundationFreestyleLog FoundationFreestyleLog[]
  languageProfiles       LanguageProfile[]
  foundationCourses      FoundationCourse[]
  foundationBossStages   FoundationBossStage[]
  bookProgress           UserBookProgress[]
}

model BillingInformation {
  id                   String          @id @default(cuid())
  user                 User            @relation(fields: [userId], references: [id])
  userId               String          @unique
  stripeCustomerId     String?
  stripeSubscriptionId String?
  currentPlan          Billing         @default(FREE)
  billingInterval      BillingInterval @default(MONTHLY)
  nextBillingDate      DateTime?
  isActive             Boolean         @default(true)
  cancelAtPeriodEnd    Boolean         @default(false)
  lastPaymentDate      DateTime?
  paymentStatus        PaymentStatus   @default(UNPAID)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
}

model AccountSettings {
  id                        String          @id @default(cuid())
  user                      User            @relation(fields: [userId], references: [id])
  userId                    String          @unique
  language                  Languages       @default(ENGLISH)
  displayName               String?
  avatarUrl                 String?
  aiVoicePreference         VoicePreference @default(MALE)
  level                     Level?          @default(BEGINNER)
  dailyEmails               Boolean?        @default(true)
  weeklyEmails              Boolean?        @default(true)
  promotionEmails           Boolean?        @default(true)
  shareReadingLogs          Boolean         @default(false)
  shareConversationActivity Boolean         @default(false)
  shareAchievements         Boolean         @default(false)
  shareLessonsAndCourses    Boolean         @default(false)
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt
}

model Teacher {
  id       String   @id @default(cuid())
  user     User     @relation(fields: [userId], references: [id])
  userId   String   @unique
  subjects String[]
  lessons  Lesson[]
}

model Journal {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  callId       String
  record       Boolean?
  recordingUrl String?
  length       String?
  completed    Boolean
  summary      String?
  to           String?
  from         String?
  transcripts  String?
  language     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Resource {
  id        String   @id @default(cuid())
  title     String
  type      String // e.g., "DOCUMENT", "VIDEO", "LINK"
  content   String
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AIGeneratedContent {
  id        String   @id @default(cuid())
  title     String
  type      String // e.g., "EXERCISE", "EXPLANATION", "QUIZ"
  content   Json
  context   String? // Store the conversation context that generated this
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Achievement {
  id           String         @id @default(cuid())
  name         String
  description  String?
  category     Category       @relation(fields: [categoryId], references: [id])
  criteria     Json
  imageUrl     String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  categoryId   String
  UserProgress UserProgress[]
}

model UserProgress {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  achievementId String
  progress      Json?
  unlockedAt    DateTime?
  isUnlocked    Boolean?    @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Category {
  id           String        @id @default(cuid())
  name         String
  achievements Achievement[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Like {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  activityId String
  type       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, activityId])
}

model Notification {
  id            String   @id @default(cuid())
  type          String
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  toUserId      String
  fromUserId    String
  activityId    String
  activityType  String
  activityTitle String
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, activityId, fromUserId])
  @@index([userId, isRead]) // For fetching unread notifications
  @@index([activityId, type]) // For activity-specific notifications
}

model UserSchedule {
  id         String        @id @default(cuid())
  user       User          @relation(fields: [userId], references: [id])
  userId     String
  schedule   EmailSchedule @relation(fields: [scheduleId], references: [id])
  scheduleId String
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([userId, scheduleId])
}

model Session {
  id        String   @id
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  impersonatedBy String?
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
